# Azure ML compute → Cursor Remote SSH
#
# 1. Copy this file:  cp .ssh/config.example .ssh/config
# 2. Fill in YOUR-* placeholders (from the compute instance Details tab).
# 3. Install into your Mac SSH config (Cursor reads ~/.ssh/config):
#       bash scripts/setup-azureml-ssh.sh
#    Or manually merge the Host block below into ~/.ssh/config.
# 4. Merge .cursor/remote-ssh.settings.example.json into Cursor User settings
#    (remoteServerListenOnSocket for this Host alias) — see Setup.md.
#
# Never commit .ssh/config or *.pem files.

### Azure ML compute instance
# Portal: Azure ML studio → Compute → your instance → Details
#   - Public IP  → HostName
#   - SSH port   → Port (often 50000)
#   - Download the private key (.pem) once; store under ~/.ssh/

Host YOUR-CI-ALIAS
    HostName YOUR.PUBLIC.IP.ADDRESS
    User azureuser
    Port 50000
    IdentityFile ~/.ssh/YOUR-KEY.pem
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ForwardAgent yes

# Optional — GitHub over SSH (only if you use git@github.com URLs)
# Host github.com
#     HostName github.com
#     User git
#     IdentityFile ~/.ssh/id_ed25519_github
#     IdentitiesOnly yes
#     UseKeychain yes
#     AddKeysToAgent yes
