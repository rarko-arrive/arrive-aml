# Machine-local secrets and overrides. Copy to .env and fill in; never commit .env.

# Required for Snowflake (service-account password). Ask a teammate / platform
# for access — not needed for the offline Cursor demo (`uv run hello`).
SNOWFLAKE_PASSWORD=changeme

# Optional connection overrides (defaults match Arrive DS workspace):
# SNOWFLAKE_USER=TOY_STORY_SERVICE_ACCOUNT
# SNOWFLAKE_ACCOUNT=arrive.east-us-2.azure
# SNOWFLAKE_WAREHOUSE=TOY_STORY_WH
# SNOWFLAKE_DATABASE=DATA_SCIENCE_WORKSPACE
# SNOWFLAKE_SCHEMA=<YOUR_SCHEMA>   (usually your user name, upper case)

# UV virtual environment location
# Set automatically by scripts/lib/setup-python-venv.sh
# Azure ML: /mnt/uv-venvs/arrive-aml (fast local disk, symlinked from .venv)
# Mac: .venv (in repo root)
UV_PROJECT_ENVIRONMENT=/mnt/uv-venvs/arrive-aml
